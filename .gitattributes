# Enforce consistent LF line endings across platforms to prevent CRLF/LF PR noise
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.feature text eol=lf
*.sh text eol=lf
.adrlint.toml text eol=lf
adrlint.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
