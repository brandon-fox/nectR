#!/usr/bin/env sh
set -eu

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs detect-secrets-hook --baseline .secrets.baseline
    if echo "$STAGED_FILES" | xargs git grep -nE '([A-Za-z]:[/\\]Users[/\\]|/(Users|home)/[^/[:space:]]+|\.gemini[/\\]|\.ollama[/\\])' -- 2>/dev/null; then
        echo "COMMIT REJECTED: Hardcoded local/private path detected in staged files." >&2
        exit 1
    fi
fi

adrlint --no-color lint
adrlint --no-color format --check
adrlint --no-color lock --check
PYTHONPATH=src python -m nectr.devtools.decisions check
PYTHONPATH=src python -m nectr.devtools.citations check
PYTHONPATH=src python -m nectr.devtools.docs_sync check
PYTHONPATH=src python -m nectr.devtools.spec_links
ruff check src tests features
ruff format --check src tests features
pymarkdown --config pyproject.toml scan README.md AGENTS.md docs/index.md docs/glossary.md docs/adr docs/planning docs/architecture docs/business
python -m mypy src .agents/lib .agents/skills tests/test_skills_spec.py
python -m pytest
python -m behave --tags=-red
